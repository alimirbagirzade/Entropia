{
  "name": "entropia-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Entropia V18 \u2014 quantitative trading strategy & backtest platform (frontend shell)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
