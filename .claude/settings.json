{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "entropia": {
      "source": {
        "source": "github",
        "repo": "alimirbagirzade/Entropia"
      }
    }
  },
  "enabledPlugins": {
    "entropia-maintenance@entropia": true
  },
  "permissions": {
    "allow": [
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "mcp__github__pull_request_read",
      "mcp__github__get_job_logs",
      "mcp__github__get_check_run",
      "mcp__github__get_commit",
      "mcp__github__list_commits",
      "mcp__github__list_branches",
      "mcp__github__list_pull_requests",
      "mcp__github__search_pull_requests",
      "mcp__github__issue_read",
      "mcp__github__list_issues",
      "mcp__github__search_issues",
      "mcp__github__get_file_contents",
      "mcp__github__search_code",
      "mcp__github__actions_list",
      "mcp__github__actions_get",
      "mcp__github__get_me",

      "Bash(uv run ruff check .)",
      "Bash(uv run ruff format --check .)",
      "Bash(uv run mypy src)",
      "Bash(uv run pytest -q)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run coverage)",
      "Bash(node scripts/memory_index.mjs --check)",
      "Bash(node scripts/memory_index.mjs --emit)",

      "mcp__codebase-memory-mcp__search_graph",
      "mcp__codebase-memory-mcp__trace_path",
      "mcp__codebase-memory-mcp__get_code_snippet",
      "mcp__codebase-memory-mcp__get_architecture",
      "mcp__codebase-memory-mcp__search_code",
      "mcp__codebase-memory-mcp__query_graph",
      "mcp__codebase-memory-mcp__list_projects",
      "mcp__codebase-memory-mcp__index_status",
      "mcp__codebase-memory-mcp__check_index_coverage",
      "mcp__codebase-memory-mcp__get_graph_schema",

      "mcp__Claude_Code_Remote__get_session",
      "mcp__Claude_Code_Remote__list_sessions",
      "mcp__Claude_Code_Remote__list_repos",
      "mcp__Claude_Code_Remote__list_environments",
      "mcp__Claude_Code_Remote__list_triggers"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/docs-history-guard.py\"",
            "if": "Bash(git commit:*)",
            "timeout": 15,
            "statusMessage": "docs history guard"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/plugins/entropia-maintenance/hooks/guard-git.sh\"",
            "timeout": 15,
            "statusMessage": "git guard"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/plugins/entropia-maintenance/hooks/guard-generated.sh\"",
            "timeout": 10,
            "statusMessage": "generated-file guard"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'o=$(scripts/ultrareview-advisor.sh 2>&1); c=$?; [ $c -ne 1 ] && echo \"$o\"; exit 0'"
          }
        ]
      }
    ]
  }
}
